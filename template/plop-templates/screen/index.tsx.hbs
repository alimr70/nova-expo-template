import React from 'react';
{{#eq screenType "auth"}}
import AuthScreenWrapper from '@/components/templates/AuthScreenWrapper';
{{else}}
import MainScreenWrapper from '@/components/templates/MainScreenWrapper';
{{/eq}}
import { Text } from '@/components/atoms';
// import styles from './styles';

const {{pascalCase name}} = () => {
  return (
    {{#eq screenType "auth"}}
    <AuthScreenWrapper>
      <Text>{{pascalCase name}} Screen</Text>
    </AuthScreenWrapper>
    {{else}}
    <MainScreenWrapper>
      <Text>{{pascalCase name}} Screen</Text>
    </MainScreenWrapper>
    {{/eq}}
  );
};

export default {{pascalCase name}};